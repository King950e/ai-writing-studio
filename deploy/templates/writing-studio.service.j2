[Unit]
Description=AI Writing Studio (Flask + Ollama)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_dir }}/app
Environment=OLLAMA_URL=http://localhost:11434/api/generate
Environment=MODEL={{ ollama_model }}
Environment=MAX_INPUT_CHARS={{ max_input_chars }}
Environment=JOB_MAX_CHARS={{ job_max_chars }}
Environment=NUM_CTX={{ num_ctx }}
Environment=WORK_HISTORY_PATH={{ app_dir }}/data/work_history.json
Environment=RATE_PER_MINUTE={{ rate_per_minute }}
Environment=RATE_PER_DAY={{ rate_per_day }}
Environment=REQUIRE_CF_ACCESS={{ require_cf_access }}
Environment=CF_TEAM_DOMAIN={{ cf_team_domain }}
Environment=CF_ACCESS_AUD={{ cf_access_aud }}
Environment=LOG_FILE={{ app_dir }}/logs/studio.log
# 1 worker so the rate limiter keeps one count; threads let several people use it at once.
ExecStart={{ app_dir }}/venv/bin/gunicorn --workers 1 --threads 4 --timeout 300 --bind 0.0.0.0:{{ app_port }} app:app
Restart=on-failure
RestartSec=5

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
